PORT=3000
# Frontend origin — used to build the password-reset link Supabase emails point back to.
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email-change verification is Supabase-native: Supabase sends and validates the code.
# There are NO backend email env vars — configure SMTP + the "Change Email Address"
# template in the Supabase dashboard (Authentication → Emails). See
# emailVerification.service.js for the exact required settings.
